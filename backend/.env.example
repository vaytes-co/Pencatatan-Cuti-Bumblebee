# Application
# Set to "production" when deploying; this also enables Secure auth cookies.
NODE_ENV=development
# HTTP port used by the Express API.
PORT=3000
# Frontend origin allowed by credentialed CORS requests.
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Create the database first. Replace the username/password with local credentials.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:5432/leave_management

# Authentication
# Shared signing secret for company and platform JWTs stored in HttpOnly cookies.
# Replace this placeholder with a unique, randomly generated secret before running.
JWT_SECRET=replace-with-a-long-random-secret